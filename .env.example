# ═════════════════════════════════════════════════════════════════════════════
# STRATA — backend environment template  (SIH 2026 PS26011)
#
#   cp .env.example .env      # then edit the values marked  <<< CHANGE ME
#
# This template matches `app/core/config.py` (pydantic `Settings`) one-for-one:
# every name below is read by the backend and nothing else is required. The
# defaults shown are the same defaults the code falls back to when a variable
# is absent, so an unmodified copy still starts — it is just insecure.
#
# Check your copy at any time:   python scripts/check_env.py
#
# NEVER commit `.env`. It holds your database password, and `frontend/.env` holds
# live Mapbox tokens. Both are git-ignored — keep it that way. (A private repo is
# not a safe place: collaborators, forks and clones all get the file, and git
# history keeps it forever.)
# ═════════════════════════════════════════════════════════════════════════════

# ── Core application ─────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | production
APP_NAME=3D-Mapping-Backend
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ── Database (PostgreSQL + PostGIS) ──────────────────────────────────────────
# Two consumers, two rules:
#   • Docker Compose builds its own DATABASE_URL for the containers from
#     POSTGRES_* below, so those three values must stay in sync with each other.
#   • DATABASE_URL / SYNC_DATABASE_URL here are consumed by anything run on the
#     HOST — `alembic`, `pytest`, and a locally started uvicorn (host = localhost).
POSTGRES_USER=postgres                  # ── consumed by docker-compose (db service)
POSTGRES_PASSWORD=postgres_password     # <<< CHANGE ME
POSTGRES_DB=ulpin_db

DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/ulpin_db
SYNC_DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/ulpin_db

# ── JWT & security (no longer used) ──────────────────────────────────────────
# Sign-in was removed from the backend: every endpoint is open, so nothing reads
# the six variables below any more. They stay declared in `app/core/config.py`
# for compatibility — delete them from your own .env whenever you like.
SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact origins of the frontend. No wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ── Cache / async jobs (Redis) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── ML engine — backend → engine connection ──────────────────────────────────
# ML_ENGINE_URL must point at the engine as reachable FROM THE BACKEND:
#   host dev + docker engine ..... http://localhost:8001
#   both in docker compose ....... http://ml-engine:8001
# ML_ENGINE_ENABLED=false runs the stack without the engine; on-demand
# ingestion will then report that vertical/unit generation is unavailable
# instead of inventing data.
ML_ENGINE_URL=http://localhost:8001
ML_ENGINE_TIMEOUT=120
ML_ENGINE_API_KEY=                      # optional shared secret; '' = no auth
ML_ENGINE_VERSION=v2.0
ML_ENGINE_ENABLED=false                 # true to enable live inference

# ── ML engine service — its own runtime knobs ────────────────────────────────
# Consumed by the `ml-engine` container in docker-compose.yml, which passes them
# to uvicorn. Harmless when running the stack without that container.
ML_ENGINE_PORT=8001
ML_ENGINE_LOG_LEVEL=INFO
ML_ENGINE_WORKERS=1

# ── Spatial reference systems ────────────────────────────────────────────────
DEFAULT_CRS=EPSG:4326                   # storage CRS (lon/lat)
INDIA_CRS=EPSG:7755                     # GCS India 2014 — metric area/distance

# ── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ── Storage & uploads ────────────────────────────────────────────────────────
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=104857600               # bytes (100 MB)
