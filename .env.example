# SIH 2026 PS26011 — 3D-Mapping-Backend
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to version control.

# ── Core Application ────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=3D-Mapping Backend
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL + PostGIS) ─────────────────────────────────────────
# The credentials below are consumed by docker-compose.yml to create the
# `db` container. POSTGRES_PASSWORD defaults to "postgres_password" when unset,
# so the DATABASE_URL password MUST match it — otherwise a host-run backend
# fails with `password authentication failed for user "postgres"`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ulpin_db

DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/ulpin_db
SYNC_DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/ulpin_db

# ── JWT & Security ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no wildcard in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── External ML Engine (Backend → ML Engine connection) ──────────────────────
ML_ENGINE_URL=http://localhost:8001
ML_ENGINE_TIMEOUT=120
ML_ENGINE_API_KEY=
ML_ENGINE_ENABLED=false

# ── ML Engine Service (ml-engine/ container internal config) ─────────────────
# These are used by the ml-engine service itself (docker-compose ml-engine block)
ML_ENGINE_PORT=8001
ML_ENGINE_LOG_LEVEL=INFO
ML_ENGINE_WORKERS=1

# ── Spatial References ───────────────────────────────────────────────────────
DEFAULT_CRS=EPSG:4326
# EPSG:7755 = GCS India 2014 — used internally for metric area/distance calculations
INDIA_CRS=EPSG:7755

# ── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=104857600
