APP_ENV=development
APP_NAME=3D-Mapping Backend
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ulpin_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/ulpin_db

SECRET_KEY=CHANGE_ME_TO_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ML_ENGINE_BASE_URL=http://localhost:8001
ML_ENGINE_TIMEOUT_SECONDS=120
ML_ENGINE_API_KEY=

DEFAULT_CRS=EPSG:4326
INDIA_CRS=EPSG:7781

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
