# ── Python & Bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
# Portable PostGIS used for local persistence verification (Phase 6).
# Never committed: it is a ~1 GB unpacked database engine, not project source.
.pg_portable/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.log
*.db
.DS_Store
Thumbs.db

# ── Environment & Secrets ────────────────────────────────────────────────────
# Real credentials must never be committed. .env.example is the committed template.
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Node & Frontend Artifacts ────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
frontend/*.tsbuildinfo
.lovable/
frontend/.lovable/

# ── ML Engine artifacts ───────────────────────────────────────────────────────
ml-engine/__pycache__/
ml-engine/.pytest_cache/
ml-engine/models/checkpoints/*.pt
ml-engine/models/checkpoints/*.pth
ml-engine/models/checkpoints/*.bin
ml-engine/models/registry/*.pt
ml-engine/models/registry/*.pth
ml-engine/datasets/raw/
ml-engine/datasets/processed/
ml-engine/reports/
