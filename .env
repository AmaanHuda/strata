# SIH 2026 PS26011 — 3D-Mapping-Backend
# Environment Configuration

# ── Core Application ────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=3D-Mapping Backend
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database (PostgreSQL + PostGIS) ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ulpin_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ulpin_db

# ── JWT & Security ───────────────────────────────────────────────────────────
SECRET_KEY=9f83b2a7d4e5f6a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── External ML Engine ───────────────────────────────────────────────────────
ML_ENGINE_URL=http://localhost:8001
ML_ENGINE_TIMEOUT=120
ML_ENGINE_API_KEY=
ML_ENGINE_ENABLED=false

# ── ML Engine Service (Internal) ─────────────────────────────────────────────
ML_ENGINE_PORT=8001
ML_ENGINE_LOG_LEVEL=INFO
ML_ENGINE_WORKERS=1

# ── Spatial References ───────────────────────────────────────────────────────
DEFAULT_CRS=EPSG:4326
INDIA_CRS=EPSG:7755

# ── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=104857600
